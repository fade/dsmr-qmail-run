#!/bin/sh
set -e

SERVICE=/etc/service

case "$1" in
    remove|deconfigure)
        # Stop supervised services cleanly on removal (not on upgrade —
        # the new postinst will reload them without a gap in service).
        if command -v svc >/dev/null 2>&1; then
            for svc in qmail-send qmail-smtpd qmail-submission; do
                if svok "$SERVICE/$svc" 2>/dev/null; then
                    echo "dsmr-qmail-run: stopping $svc..."
                    svc -d "$SERVICE/$svc" 2>/dev/null || true
                fi
            done
        fi
        ;;

    upgrade|failed-upgrade)
        # Leave services running; postinst of the new version reloads them.
        ;;

    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
