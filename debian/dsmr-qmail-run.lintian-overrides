# The MTA commands have no man pages here (sendmail/mailq are symlinks to qmail
# tools; newaliases delegates to fastforward's qmail-newaliases to rebuild
# /etc/aliases.cdb). Man pages for them are future work, recorded in debian/TODO.
dsmr-qmail-run: no-manual-page [usr/sbin/sendmail]
dsmr-qmail-run: no-manual-page [usr/bin/mailq]
dsmr-qmail-run: no-manual-page [usr/sbin/newaliases]
