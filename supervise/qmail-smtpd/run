#!/bin/sh
QMAILDIR=$(getent passwd qmaild | cut -d: -f6)
QMAILDUID=$(id -u vpopmail)
NOFILESGID=$(id -g vpopmail)
MAXSMTPD=$(cat "$QMAILDIR/control/concurrencyincoming")
SOFTLIMIT=$(cat "$QMAILDIR/control/softlimit")
LOCAL=$(head -1 "$QMAILDIR/control/me")
TCPRULES_DIR="$QMAILDIR/control"

# SPF behaviour: read from control file; default to 1 (log only) if absent.
if [ -f "$QMAILDIR/control/spfbehavior" ]; then
    export spfbehavior=$(cat "$QMAILDIR/control/spfbehavior")
else
    export spfbehavior=1
fi

# qmail-spp plugins.  ENABLE_SPP must be unset (not just "0") when SPP is not
# configured: the qmail-spp patch treats any presence of the variable as a
# trigger to initialise SPP, causing "421 cannot_read_controls" if the
# smtpplugins control file is absent.
export HELO_DNS_CHECK=GNLR
if [ -f "$QMAILDIR/control/smtpplugins" ] && [ -d "$QMAILDIR/plugins" ]; then
    export ENABLE_SPP=1
fi

export SMTPD_GREETDELAY=5
export DROP_PRE_GREET=1
export FORCEAUTHMAILFROM=1

# Recipient validation gate.
#
# When localfirst-rcptcheck (from dsmr-localfirst) is installed it is the sole
# gate: it accepts system-user recipients on hybrid domains that chkuser cannot
# see, validates vpopmail recipients via vrcptcheck, and chains to the outbound
# overlimit throttle on accept.  chkuser is therefore left off.  When the bridge
# is absent, fall back to chkuser for vpopmail recipient validation plus the
# standalone overlimit throttle, exactly as before.
if [ -x "$QMAILDIR/bin/localfirst-rcptcheck" ]; then
    export RCPTCHECK="$QMAILDIR/bin/localfirst-rcptcheck"
    export RCPTCHECKRELAYCLIENT=1
else
    export CHKUSER_START=ALWAYS
    if [ -x "$QMAILDIR/bin/rcptcheck-overlimit" ]; then
        export RCPTCHECK="$QMAILDIR/bin/rcptcheck-overlimit"
        export RCPTCHECKRELAYCLIENT=1
    fi
fi

exec /usr/bin/softlimit -m "$SOFTLIMIT" \
    /usr/bin/tcpserver -v -R -l "$LOCAL" \
    -x "${TCPRULES_DIR}/tcp.smtp.cdb" -c "$MAXSMTPD" \
    -u "$QMAILDUID" -g "$NOFILESGID" 0 25 \
    "$QMAILDIR/bin/qmail-smtpd" /bin/true 2>&1
