#!/bin/sh
QMAILDIR=$(getent passwd qmaild | cut -d: -f6)
QMAILDUID=$(id -u vpopmail)
NOFILESGID=$(id -g vpopmail)
MAXSMTPD=$(cat "$QMAILDIR/control/concurrencyincoming")
SOFTLIMIT=$(cat "$QMAILDIR/control/softlimit")
LOCAL=$(head -1 "$QMAILDIR/control/me")
TCPRULES_DIR="$QMAILDIR/control"

# Require authentication on the submission port.
export SMTPAUTH="!"
export SMTPD_GREETDELAY=3
export DROP_PRE_GREET=1
export FORCEAUTHMAILFROM=1

# Recipient validation gate (see qmail-smtpd/run for the rationale).  Enabled
# only by control/localfirst (first line "1"); installing the binary alone never
# changes validation.  On the submission port localfirst-rcptcheck accepts
# external relay targets, validates local recipients, and chains to the outbound
# overlimit throttle on accept, so RCPTCHECKRELAYCLIENT must remain set for
# authenticated submitters.
if [ -x "$QMAILDIR/bin/localfirst-rcptcheck" ] && \
   [ "$(head -1 "$QMAILDIR/control/localfirst" 2>/dev/null)" = "1" ]; then
    export RCPTCHECK="$QMAILDIR/bin/localfirst-rcptcheck"
    export RCPTCHECKRELAYCLIENT=1
else
    export CHKUSER_START=ALWAYS
    if [ -x "$QMAILDIR/bin/rcptcheck-overlimit" ]; then
        export RCPTCHECK="$QMAILDIR/bin/rcptcheck-overlimit"
        export RCPTCHECKRELAYCLIENT=1
    fi
fi

# Authentication backend selection.
#
# checkpassword-dovecot (from dsmr-checkpassword-dovecot, if installed) bridges
# SMTP-AUTH through dovecot's auth-client protocol, so vpopmail virtual users,
# curated system users in /etc/dovecot/system-passwd, and PAM accounts all
# authenticate from one chained passdb.  When the bridge is absent, fall back
# to vchkpw, which authenticates only vpopmail virtual users.
if [ -x /var/qmail/bin/checkpassword-dovecot ]; then
    AUTH_PROG=/var/qmail/bin/checkpassword-dovecot
else
    AUTH_PROG=/home/vpopmail/bin/vchkpw
fi

exec /usr/bin/softlimit -m "$SOFTLIMIT" \
    /usr/bin/tcpserver -v -R -l "$LOCAL" \
    -x "${TCPRULES_DIR}/tcp.submission.cdb" -c "$MAXSMTPD" \
    -u "$QMAILDUID" -g "$NOFILESGID" 0 587 \
    "$QMAILDIR/bin/qmail-smtpd" \
    "$AUTH_PROG" /bin/true 2>&1
